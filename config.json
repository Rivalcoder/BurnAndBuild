{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "3.0.0",
  "metadata": {
    "name": "BurnAndBuild - Disposable Dev Environment Automation",
    "description": "High-velocity automation framework to burn disposable VMs and rebuild pristine, full-stack software, mobile, AI, and DevOps development environments in minutes on Windows & Linux."
  },
  "settings": {
    "workspaceRoot": "C:\\Workspace",
    "linuxWorkspaceRoot": "/workspace",
    "toolsDirectory": "C:\\Tools",
    "linuxToolsDirectory": "/opt",
    "logDirectory": "C:\\Logs\\BurnAndBuild",
    "linuxLogDirectory": "/var/log/burnandbuild",
    "enableLongPaths": true,
    "enableDeveloperMode": true,
    "preventSleep": true,
    "showFileExtensions": true,
    "showHiddenFiles": true,
    "linuxMaxUserWatches": 524288
  },
  "selectableTools": [
    {
      "id": "antigravityCli",
      "name": "Antigravity CLI (agy)",
      "category": "AI & Autonomous Agents",
      "tag": "AI CLI",
      "description": "Google Antigravity TUI terminal assistant with multi-step reasoning, slash commands & subagents",
      "defaultChecked": true,
      "wingetId": "Google.AntigravityCLI"
    },
    {
      "id": "antigravityIde",
      "name": "Antigravity IDE",
      "category": "AI & Autonomous Agents",
      "tag": "AI IDE",
      "description": "Google AI-first standalone development environment with agent workspace and auxiliary panes",
      "defaultChecked": true,
      "wingetId": "Google.AntigravityIDE"
    },
    {
      "id": "cursor",
      "name": "Cursor AI Editor",
      "category": "AI & Autonomous Agents",
      "tag": "AI IDE",
      "description": "Anysphere Cursor AI-powered code editor with inline code generation and chat lenses",
      "defaultChecked": true,
      "wingetId": "Anysphere.Cursor"
    },
    {
      "id": "codex",
      "name": "OpenAI Codex CLI",
      "category": "AI & Autonomous Agents",
      "tag": "AI CLI",
      "description": "OpenAI Codex command-line interface for autonomous coding, code reviews, and reasoning",
      "defaultChecked": true,
      "wingetId": "OpenAI.Codex"
    },
    {
      "id": "flutter",
      "name": "Flutter SDK",
      "category": "Mobile Development",
      "tag": "Framework",
      "description": "Google Flutter SDK for cross-platform iOS, Android, Web & Desktop development",
      "defaultChecked": true,
      "requires": ["gitCli"]
    },
    {
      "id": "android",
      "name": "Android SDK & Tools",
      "category": "Mobile Development",
      "tag": "Mobile SDK",
      "description": "Android platform-tools (adb), cmdline-tools, build-tools 34, auto-accepted licenses",
      "defaultChecked": true,
      "requires": ["java"]
    },
    {
      "id": "node",
      "name": "Node.js LTS & npm",
      "category": "Web & Backend Runtimes",
      "tag": "Runtime",
      "description": "Node.js LTS runtime with npm package manager via Fast Node Manager (fnm)",
      "defaultChecked": true
    },
    {
      "id": "python",
      "name": "Python 3.12 & uv",
      "category": "Web & Backend Runtimes",
      "tag": "Runtime",
      "description": "Python 3.12 interpreter, pip, and uv ultra-fast package manager",
      "defaultChecked": true
    },
    {
      "id": "docker",
      "name": "Docker Desktop",
      "category": "Containers & Cloud",
      "tag": "Containers",
      "description": "Docker engine, Docker Compose, container runtime & WSL2 integration",
      "defaultChecked": true
    },
    {
      "id": "java",
      "name": "Java JDK 17 (Temurin)",
      "category": "Languages & SDKs",
      "tag": "JDK",
      "description": "Eclipse Temurin OpenJDK 17 LTS, sets JAVA_HOME (Required for Android & Gradle)",
      "defaultChecked": true
    },
    {
      "id": "gradle",
      "name": "Gradle Build Tool",
      "category": "Languages & SDKs",
      "tag": "Build Tool",
      "description": "Gradle build automation tool for Java, Kotlin & Android projects",
      "defaultChecked": true,
      "requires": ["java"]
    },
    {
      "id": "gitCli",
      "name": "Git & Core CLI Suite",
      "category": "Core CLI & Shell",
      "tag": "CLI Tools",
      "description": "Git, GitHub CLI, 7-Zip, jq, ripgrep, fzf, PowerShell 7, Windows Terminal",
      "defaultChecked": true
    },
    {
      "id": "vscode",
      "name": "Visual Studio Code",
      "category": "IDEs & Code Editors",
      "tag": "IDE",
      "description": "VS Code with automated extensions tailored for selected tools",
      "defaultChecked": true
    },
    {
      "id": "notepadpp",
      "name": "Notepad++",
      "category": "IDEs & Code Editors",
      "tag": "Editor",
      "description": "Fast, lightweight source code and text editor",
      "defaultChecked": false
    },
    {
      "id": "chrome",
      "name": "Google Chrome",
      "category": "Browsers & Utilities",
      "tag": "Browser",
      "description": "Google Chrome browser (essential for Flutter web development & debugging)",
      "defaultChecked": true
    },
    {
      "id": "brave",
      "name": "Brave Browser",
      "category": "Browsers & Utilities",
      "tag": "Browser",
      "description": "Privacy-focused high performance Chromium browser with ad/tracker blocking",
      "defaultChecked": false,
      "wingetId": "Brave.Brave"
    },
    {
      "id": "postman",
      "name": "Postman API Client",
      "category": "API & Database Tools",
      "tag": "API Tool",
      "description": "Complete platform for API testing, mock servers, and collaboration",
      "defaultChecked": false
    },
    {
      "id": "dbeaver",
      "name": "DBeaver Community",
      "category": "API & Database Tools",
      "tag": "Database",
      "description": "Universal database manager for PostgreSQL, MySQL, SQLite, and more",
      "defaultChecked": false
    },
    {
      "id": "powerbi",
      "name": "Microsoft Power BI Desktop",
      "category": "Data & Analytics Tools",
      "tag": "Analytics",
      "description": "Enterprise business intelligence, interactive data modeling, and visualization suite",
      "defaultChecked": false,
      "wingetId": "Microsoft.PowerBI"
    },
    {
      "id": "jira",
      "name": "Atlassian Jira CLI & Tools",
      "category": "Project Management & Collaboration",
      "tag": "Agile CLI",
      "description": "Official Atlassian CLI (acli) for Jira issues, sprints, and VS Code Jira integration",
      "defaultChecked": false,
      "wingetId": "Atlassian.AtlassianCLI"
    },
    {
      "id": "baseWindows",
      "name": "Windows Dev Optimizations",
      "category": "System Configuration",
      "tag": "OS Tweaks",
      "description": "Win32 Long Paths (>260 chars), Dev Mode, Never Sleep, File Explorer tweaks",
      "defaultChecked": true
    }
  ],
  "presets": {
    "all": [
      "antigravityCli",
      "antigravityIde",
      "cursor",
      "codex",
      "flutter",
      "android",
      "node",
      "python",
      "docker",
      "java",
      "gradle",
      "gitCli",
      "vscode",
      "notepadpp",
      "chrome",
      "brave",
      "postman",
      "dbeaver",
      "powerbi",
      "jira",
      "baseWindows"
    ],
    "ai": [
      "baseWindows",
      "gitCli",
      "node",
      "python",
      "antigravityCli",
      "antigravityIde",
      "cursor",
      "codex",
      "vscode"
    ],
    "mobile": [
      "baseWindows",
      "gitCli",
      "java",
      "android",
      "gradle",
      "flutter",
      "vscode",
      "chrome"
    ],
    "web": [
      "baseWindows",
      "gitCli",
      "node",
      "python",
      "docker",
      "vscode",
      "chrome",
      "postman"
    ],
    "devops": [
      "baseWindows",
      "gitCli",
      "python",
      "docker",
      "vscode"
    ],
    "minimal": [
      "baseWindows",
      "gitCli",
      "vscode"
    ]
  },
  "wingetPackages": {
    "aiTools": {
      "antigravityCli": { "id": "Google.AntigravityCLI", "name": "Antigravity CLI" },
      "antigravityIde": { "id": "Google.AntigravityIDE", "name": "Antigravity IDE" },
      "cursor": { "id": "Anysphere.Cursor", "name": "Cursor AI Editor" },
      "codex": { "id": "OpenAI.Codex", "name": "OpenAI Codex CLI" }
    },
    "coreCli": [
      { "id": "Git.Git", "name": "Git for Windows" },
      { "id": "7zip.7zip", "name": "7-Zip File Archiver" },
      { "id": "jqlang.jq", "name": "jq JSON Processor" },
      { "id": "BurntSushi.ripgrep.MSVC", "name": "ripgrep" },
      { "id": "junegunn.fzf", "name": "fzf Command-line Fuzzy Finder" },
      { "id": "Microsoft.PowerShell", "name": "PowerShell 7 (pwsh)" },
      { "id": "Microsoft.WindowsTerminal", "name": "Windows Terminal" },
      { "id": "GitHub.cli", "name": "GitHub CLI" }
    ],
    "runtimes": {
      "java": { "id": "EclipseAdoptium.Temurin.17.JDK", "name": "Eclipse Temurin JDK 17 (LTS)" },
      "node": { "id": "Schniz.fnm", "name": "Fast Node Manager (fnm)" },
      "python": [
        { "id": "astral-sh.uv", "name": "uv (Ultra-fast Python Package Manager)" },
        { "id": "Python.Python.3.12", "name": "Python 3.12" }
      ],
      "gradle": { "id": "Gradle.Gradle", "name": "Gradle Build Tool" }
    },
    "docker": { "id": "Docker.DockerDesktop", "name": "Docker Desktop" },
    "ides": {
      "vscode": { "id": "Microsoft.VisualStudioCode", "name": "Visual Studio Code" },
      "notepadpp": { "id": "Notepad++.Notepad++", "name": "Notepad++" }
    },
    "utilities": {
      "chrome": { "id": "Google.Chrome", "name": "Google Chrome" },
      "brave": { "id": "Brave.Brave", "name": "Brave Browser" },
      "powerbi": { "id": "Microsoft.PowerBI", "name": "Microsoft Power BI Desktop" },
      "jira": { "id": "Atlassian.AtlassianCLI", "name": "Atlassian Jira CLI" },
      "postman": { "id": "Postman.Postman", "name": "Postman API Platform" },
      "dbeaver": { "id": "DBeaver.DBeaver", "name": "DBeaver Community Edition" }
    }
  },
  "flutterSdk": {
    "installDirectory": "C:\\Tools\\flutter",
    "linuxInstallDirectory": "/opt/flutter",
    "gitRepoUrl": "https://github.com/flutter/flutter.git",
    "gitBranch": "stable",
    "releasesJsonUrl": "https://storage.googleapis.com/flutter_infra_release/releases/releases_windows.json",
    "linuxTarUrl": "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.24.3-stable.tar.xz"
  },
  "androidSdk": {
    "installDirectory": "C:\\Android\\android-sdk",
    "linuxInstallDirectory": "/opt/android-sdk",
    "cmdlineToolsZipUrl": "https://dl.google.com/android/repository/commandlinetools-win-11076708_latest.zip",
    "linuxCmdlineToolsZipUrl": "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip",
    "cmdlineToolsVersion": "11076708",
    "packagesToInstall": [
      "platform-tools",
      "cmdline-tools;latest",
      "build-tools;34.0.0",
      "platforms;android-34",
      "extras;google;m2repository"
    ]
  },
  "linuxPackages": {
    "aiTools": {
      "antigravityCli": {
        "url": "https://storage.googleapis.com/antigravity-public/antigravity-cli/1.2.12-5784551402897408/linux-x64/cli_linux_x64",
        "binaryName": "agy"
      },
      "cursor": {
        "url": "https://downloader.cursor.sh/linux/appImage/x64",
        "binaryName": "cursor"
      },
      "codex": {
        "url": "https://github.com/openai/codex/releases/download/rust-v0.158.0/codex-x86_64-unknown-linux-musl.tar.gz",
        "binaryName": "codex"
      }
    },
    "gradle": {
      "url": "https://services.gradle.org/distributions/gradle-8.7-bin.zip",
      "installDirectory": "/opt/gradle"
    },
    "apt": {
      "base": ["build-essential", "curl", "wget", "gnupg", "ca-certificates", "software-properties-common", "apt-transport-https", "unzip", "tar", "gzip"],
      "coreCli": ["git", "jq", "ripgrep", "fzf", "p7zip-full", "tmux", "zsh"],
      "java": ["openjdk-17-jdk", "openjdk-17-jre-headless"],
      "python": ["python3", "python3-pip", "python3-venv", "python3-dev"],
      "dbeaver": ["dbeaver-ce"]
    },
    "dnf": {
      "base": ["@development-tools", "curl", "wget", "gnupg2", "ca-certificates", "unzip", "tar", "gzip"],
      "coreCli": ["git", "jq", "ripgrep", "fzf", "p7zip", "tmux", "zsh"],
      "java": ["java-17-openjdk-devel"],
      "python": ["python3", "python3-pip", "python3-devel"]
    }
  },
  "environmentVariables": {
    "machine": [
      { "name": "JAVA_HOME", "value": "C:\\Program Files\\Eclipse Adoptium\\jdk-17" },
      { "name": "ANDROID_HOME", "value": "C:\\Android\\android-sdk" },
      { "name": "ANDROID_SDK_ROOT", "value": "C:\\Android\\android-sdk" },
      { "name": "FLUTTER_HOME", "value": "C:\\Tools\\flutter" },
      { "name": "GRADLE_HOME", "value": "C:\\Tools\\gradle" }
    ],
    "linuxEnvironment": {
      "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64",
      "ANDROID_HOME": "/opt/android-sdk",
      "ANDROID_SDK_ROOT": "/opt/android-sdk",
      "FLUTTER_HOME": "/opt/flutter",
      "GRADLE_HOME": "/opt/gradle/gradle-8.7"
    },
    "pathAdditions": [
      "C:\\Tools\\flutter\\bin",
      "C:\\Android\\android-sdk\\cmdline-tools\\latest\\bin",
      "C:\\Android\\android-sdk\\platform-tools",
      "C:\\Android\\android-sdk\\build-tools\\34.0.0",
      "C:\\Tools\\gradle\\bin",
      "C:\\Program Files\\Git\\cmd",
      "C:\\Program Files\\PowerShell\\7",
      "C:\\Program Files\\Docker\\Docker\\resources\\bin"
    ],
    "linuxPathAdditions": [
      "/opt/flutter/bin",
      "/opt/android-sdk/cmdline-tools/latest/bin",
      "/opt/android-sdk/platform-tools",
      "/opt/android-sdk/build-tools/34.0.0",
      "/opt/gradle/bin",
      "/usr/local/bin",
      "$HOME/.local/bin",
      "$HOME/.cargo/bin"
    ]
  },
  "vscode": {
    "coreExtensions": [
      "eamodio.gitlens",
      "ms-vscode.powershell",
      "EditorConfig.EditorConfig",
      "tamasfe.even-better-toml",
      "redhat.vscode-yaml"
    ],
    "toolExtensions": {
      "flutter": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ],
      "python": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "node": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "docker": [
        "ms-azuretools.vscode-docker"
      ],
      "java": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle"
      ],
      "jira": [
        "Atlassian.atlascode"
      ]
    }
  }
}
